{"nodes": [{"id": "project_guide_doc", "label": "PROJECT_GUIDE.md Architecture & Timeline Guide", "file_type": "document", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_guide_temporal_causality", "label": "24-Hour Timeline & Publication Lag Causality", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Day-ahead forecasts (D-1 13:00) and Nord Pool spot prices (D-1 14:00) act as legal future features for steps 1..40, while real-time consumption/flows (30m lag) and imbalance/mFRR/aFRR (60m lag) act as current grid stress indicators."}, {"id": "project_guide_imbalance_spread_strategy", "label": "Imbalance Spread Forecasting Strategy (Delta P = Imbalance - Spot)", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because imbalance price equals spot price when mFRR direction is none and spikes are defined relative to spot +/- 50 EUR/MWh, anchoring on spot_price_target or predicting the spread Delta P directly beats the 66.20 EUR/MWh baseline MAE."}, {"id": "project_guide_six_lightgbm_models", "label": "Six LightGBM Model Suite (3x Quantile, 1x Multiclass, 2x Binary)", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trains 3 quantile regressors (p10, p50, p90), 1 multiclass classifier (p_up, p_down, p_none), and 2 binary classifiers (p_spike_high, p_spike_low) over the 40-step feature matrix X."}, {"id": "project_guide_feature_matrix_x", "label": "Feature Matrix X (Future Target Features + Real-Time Lag Features)", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines future delivery-time features (spot_price_target, wind/solar/consumption DA forecasts, residual_load_forecast) with origin-time lag features (last_imbalance_price, last_mfrr/afrr volumes, consumption_forecast_error, net_cross_border_flow)."}], "edges": [{"source": "project_guide_doc", "target": "project_guide_temporal_causality", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_doc", "target": "project_guide_imbalance_spread_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_doc", "target": "project_guide_six_lightgbm_models", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_doc", "target": "project_guide_feature_matrix_x", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_doc", "target": "validate_submission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_doc", "target": "score", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "project_guide_temporal_causality", "target": "agents_rule1_first_usable_origin_utc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT_GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "pr